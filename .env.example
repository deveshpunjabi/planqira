# Planqira Configuration (Google DeepMind Gemma 4 / Gemini API)
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
# Keep this file sanitized. Do NOT commit live API keys.

GEMINI_API_KEY=
# Configure a model available to your account; verify a live extraction before presenting it.
AI_MODEL=gemma-4-26b-a4b-it

# Optional explicit cross-origin frontend origins, comma-separated. Same-origin needs no setting.
PLANQIRA_ALLOWED_ORIGINS=
# Local durable SQLite file. Vercel /tmp storage is demonstration-only.
# PLANQIRA_DB_PATH=planqira.db
